# Stock Prediction CLI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys
# =============================================================================

# Alpha Vantage API Key
# Get your free API key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests per day
# Premium tiers available for higher limits
ALPHA_VANTAGE_API_KEY=your_key_here

# API Key for securing the REST API endpoints
# Generate a secure random key using: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_secure_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Data directory (default: ./data)
# DATA_DIR=./data

# Model directory (default: ./models)
# MODEL_DIR=./models

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 1. NEVER commit this file to version control
# 2. The .env file is already in .gitignore to prevent accidental exposure
# 3. If you accidentally commit secrets, rotate them immediately
# 4. Use different API keys for development and production
# =============================================================================
